+
+def _claude_home() -> Path:
+    env = os.environ.get("CLAUDE_HOME") or os.environ.get("CLAUDE_CONFIG_DIR")
+    return Path(env) if env else Path.home() / ".claude"
+
+
+def _contract_dir() -> Path | None:
+    """Where the contract skill lives: the install first, then this repo's own tree."""
+    for cand in (
+        _claude_home() / "skills" / "contract",
+        Path(__file__).resolve().parent.parent / "skills" / "core" / "contract",
+    ):
+        if (cand / "index.json").is_file() and (cand / "contracts_lib.py").is_file():
+            return cand
+    return None
+
+
+def _contract_hint(data: dict, prompt: str) -> str | None:
+    """One advisory line for a task that matches a contract card, else None. Never raises.
+
+    Silent for slash commands (the user already chose a tool) and for the `fast:` / `just do:`
+    Speed Mode prefixes (the user asked for action only, no commentary).
+    """
+    try:
+        text = prompt.strip()
+        if len(text) < _MIN_CONTRACT_PROMPT or text.startswith("/"):
+            return None
+        if text.lower().startswith(_SPEED_PREFIXES):
+            return None
+        # Not installed at all is a legitimate silence. A half-installed skill directory
+        # (present, but index.json or contracts_lib.py missing) is a fault worth a record,
+        # whether or not a repo checkout lets the hook fall back and speak anyway.
+        installed = _claude_home() / "skills" / "contract"
+        if installed.is_dir() and not (
+            (installed / "index.json").is_file() and (installed / "contracts_lib.py").is_file()
+        ):
+            _log_contract_failure("install-incomplete")
+        skill_dir = _contract_dir()
+        if skill_dir is None:
+            return None
+        sys.path.insert(0, str(skill_dir))
+        try:
+            import contracts_lib as cl
+        except Exception as exc:  # noqa: BLE001 - a broken install must not fail a session
+            _log_contract_failure("import-failed", exc)
+            return None
+        finally:
+            sys.path.remove(str(skill_dir))
+        index = cl.load_index(skill_dir / "index.json")
+        if index is None:
+            # Missing, unparsable or wrong-version index: silence that is a fault, not a choice.
+            _log_contract_failure("index-unreadable")
+            return None
+        routed = cl.route(text, index, _contract_stats())
+        line: str | None = cl.hint(routed)
+        if line:
+            _log_contract_route(data, text, routed)
+        return line
+    except Exception as exc:  # noqa: BLE001 - a hint must never fail a session
+        _log_contract_failure("route-failed", exc)
+        return None
+
+
+def _log_contract_failure(kind: str, exc: BaseException | None = None) -> None:
+    """Make a broken hint distinguishable from a deliberately silent one.
+
+    Without this, "the install lost contracts_lib.py" and "no card matched this prompt" look
+    identical from the outside. Records the failure kind and the exception TYPE only: messages
+    can carry paths or prompt fragments.
+    """
+    try:
+        log_path = _claude_home() / "logs" / "contract_errors.jsonl"
+        log_path.parent.mkdir(parents=True, exist_ok=True)
+        rotate_log_if_large(log_path)
+        entry = {
+            "ts": datetime.now(UTC).isoformat(),
+            "kind": kind,
+            "error": type(exc).__name__ if exc is not None else None,
+        }
+        with open(log_path, "a", encoding="utf-8") as f:
+            f.write(json.dumps(entry) + "\n")
+    except OSError:
+        pass
+
+
+def _contract_stats() -> dict[str, dict[str, int]] | None:
+    """Outcome statistics written by the (separate) effectiveness report; absent until then."""
+    try:
+        raw = json.loads((_claude_home() / "state" / "contract_stats.json").read_text("utf-8"))
+    except (OSError, ValueError):
+        return None
+    return raw if isinstance(raw, dict) else None
+
